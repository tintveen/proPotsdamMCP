{
  "name": "propotsdam-mcp",
  "version": "0.3.0",
  "description": "Local MCP server for the ProPotsdam customer portal",
  "type": "module",
  "bin": {
    "propotsdam-mcp": "dist/bin.js",
    "propotsdam-cli": "dist/bin.js"
  },
  "files": [
    "dist/",
    "docs/security-check.md",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tintveen/proPotsdamMCP.git"
  },
  "bugs": {
    "url": "https://github.com/tintveen/proPotsdamMCP/issues"
  },
  "homepage": "https://github.com/tintveen/proPotsdamMCP#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && node -e \"require('node:fs').chmodSync('dist/bin.js', 0o755)\"",
    "check": "tsc --noEmit -p tsconfig.json",
    "auth:set": "node dist/bin.js auth set",
    "discover": "node dist/bin.js discover",
    "actions": "node dist/bin.js actions",
    "dev": "tsx src/index.ts",
    "prepack": "npm run build",
    "package:verify": "node scripts/verify-package.mjs",
    "release:check": "npm run check && npm test && npm audit --audit-level=high && npm audit --omit=dev --audit-level=high && npm run package:verify",
    "test": "vitest run",
    "test:live": "PROPPOTSDAM_LIVE_TEST=1 vitest run tests/live-read-pass.test.ts",
    "test:watch": "vitest"
  },
  "keywords": [
    "mcp",
    "propotsdam",
    "easysquare"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cheerio": "^1.2.0",
    "fast-xml-parser": "^5.2.5",
    "keytar": "^7.9.0",
    "sharp": "^0.35.3",
    "tough-cookie": "^6.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsx": "^4.20.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  }
}
