{
  "name": "propotsdam-mcp",
  "version": "0.1.0",
  "description": "Local MCP server for the ProPotsdam customer portal",
  "type": "module",
  "bin": {
    "propotsdam-mcp": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "docs/security-check.md",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tintveen/proPotsdamMCP.git"
  },
  "bugs": {
    "url": "https://github.com/tintveen/proPotsdamMCP/issues"
  },
  "homepage": "https://github.com/tintveen/proPotsdamMCP#readme",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "auth:set": "node dist/cli.js auth set",
    "discover": "node dist/cli.js discover",
    "actions": "node dist/cli.js actions",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:live": "PROPPOTSDAM_LIVE_TEST=1 vitest run tests/live-read-pass.test.ts",
    "test:watch": "vitest"
  },
  "keywords": [
    "mcp",
    "propotsdam",
    "easysquare"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "fast-xml-parser": "^5.2.5",
    "keytar": "^7.9.0",
    "tough-cookie": "^6.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
